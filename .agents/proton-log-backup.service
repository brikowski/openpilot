[Unit]
Description=Opt-in Proton backup of closed full-rate rlogs
After=comma.service

[Service]
Type=simple
User=comma
WorkingDirectory=/data/openpilot
ExecStart=/usr/local/venv/bin/python3 /data/proton-log-backup/comma_log_backup.py run
Restart=on-failure
RestartSec=30
Nice=19
IOSchedulingClass=idle
CPUWeight=1
MemoryMax=512M
OOMScoreAdjust=500
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
KillMode=control-group
TimeoutStopSec=5
